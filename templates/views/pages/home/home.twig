{% extends 'layouts/layout.twig' %}

{% block title %} Inicio {% endblock %}

{% block content %}
<style>
    @keyframes fade-up { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    @keyframes float   { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }

    .anim   { opacity: 0; animation: fade-up .25s cubic-bezier(.21, .7, .25, 1) forwards; }
    .anim-1 { animation-delay: .05s; }
    .anim-2 { animation-delay: .16s; }
    .anim-3 { animation-delay: .27s; }
    .anim-4 { animation-delay: .38s; }
    .floaty { animation: float 5s ease-in-out infinite; }

    @media (prefers-reduced-motion: reduce) {
        .anim, .floaty { animation: none; opacity: 1; }
    }
</style>

<div class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[#16171D] px-6">

    {# Glow sutil detrás de los logos #}
    <div class="pointer-events-none absolute left-1/2 top-[45%] h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/10 blur-[90px]"></div>

    <main class="relative w-full max-w-xl text-center">

        {# Logos #}
        <div class="anim anim-1 mb-6 flex items-center justify-center gap-6">
            <img src="data:image/png;base64," alt="Slim 4" class="floaty h-16 w-auto transition-transform duration-300 hover:scale-110">
            <span class="w-[50px]"></span>
