        <h1 class="anim anim-2 text-5xl font-medium tracking-tight text-[#F1FAFF] sm:text-6xl">
            Slim <span class="text-[#505264]">+</span> Vite
        </h1>

        <div class="anim anim-4 mt-9 flex flex-wrap items-center justify-center gap-3">
            <a href="/tasks" class="btn btn-primary gap-2 shadow-sm">
                Ver tareas
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
